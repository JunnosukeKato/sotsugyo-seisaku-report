# 年度設定の配信の窓口（Apps Script「卒業制作報告書_配信」のウェブアプリ）。gas/deployments.json の api.url と同じ
# 公開して差し支えない情報（題目・コース名・教員名など）だけを返す
VITE_CONFIG_API_URL=https://script.google.com/macros/s/AKfycbxQnwygZE6gDD2gp9w3ZP7TUdDnVnChE3uAZlWDxYlreaMJD7Sp1Tx2H6PF_CmAsqO1uQ/exec

# ソースコードの場所（ライセンス AGPL-3.0 に従い、ツールの画面に表示する）。GitHub のリポジトリが決まったら設定する
VITE_SOURCE_URL=https://github.com/JunnosukeKato/sotsugyo-seisaku-report

# Google ドライブに保存するときのログイン用の登録（Google Cloud の OAuth クライアント ID。公開して差し支えない）
# Google Cloud のプロジェクト sotsugyo-seisaku-report（組織 bunka-wu.ac.jp、対象は「内部」）。空にすると、接続テストのページ（drive-test.html）に入力欄を出す
VITE_GOOGLE_CLIENT_ID=956591522646-nubkurmpjr9gbi5n5hfu68uli798de73.apps.googleusercontent.com
